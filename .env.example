# Spotify API credentials (optional - for Spotify playlist/track metadata)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Output directory (default: /app/output)
OUTPUT_DIR=/app/output

# Audio quality (default: 192)
AUDIO_QUALITY=192

# YouTube-DL options
YT_DLP_FORMAT=bestaudio/best